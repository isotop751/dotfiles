

alias n="nano"

# zoxide
alias cd="z"
alias zq="zoxide query --interactive"

#exa 
alias l="exa --long --header --icons --git"
alias l3="exa --long --tree --level=3"

alias r="ranger"
alias ll="ls -la --color=auto"
alias ls='ls --color=auto'
alias grep="grep --color=auto"
alias mux="tmuxinator"
alias hx="helix"
alias rat="bat --paging=never"


